{
  "name": "OA-99 · Error Handler",
  "nodes": [
    {
      "parameters": {
        "content": "## Error handler\nEvery outreach workflow points its **Settings → Error workflow** here.\n\n1. Error Trigger receives the failed execution\n2. Config holds ALERT_EMAIL + SHEET_ID\n3. Format a readable alert\n4. Email the alert **and** append a row to the **Errors** tab (each branch continues even if the other fails).",
        "height": 240,
        "width": 520,
        "color": 3
      },
      "id": "cd9854f6-a0f5-f56a-130c-fa477caabf2c",
      "name": "Note: Error handler",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -260
      ]
    },
    {
      "parameters": {},
      "id": "f8bd8bf9-a9f4-fe8c-8ab4-0cce4c5a3b5e",
