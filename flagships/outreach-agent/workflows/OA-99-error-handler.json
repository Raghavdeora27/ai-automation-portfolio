      "id": "90898e96-ab82-7615-1455-943b22227d89",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $('Error Trigger').first().json;\nconst ex = e.execution || {};\nconst trig = e.trigger || {};\nconst err = ex.error || trig.error || {};\nconst out = {\n  timestamp: new Date().toISOString(),\n  workflow: (e.workflow && e.workflow.name) || 'unknown workflow',\n  node: ex.lastNodeExecuted || (err.node && err.node.name) || 'n/a (trigger error)',\n  error_message: String(err.message || err.description || 'Unknown error').slice(0, 1500),\n  execution_id: ex.id || '',\n  execution_url: ex.url || '',\n  mode: ex.mode || trig.mode || '',\n};\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nout.subject = `[Outreach ALERT] ${out.workflow} failed at \"${out.node}\"`;\nout.html = `<h3>Outreach workflow error</h3>\n<p><b>Workflow:</b> ${esc(out.workflow)}<br><b>Node:</b> ${esc(out.node)}<br><b>When (UTC):</b> ${out.timestamp}<br><b>Mode:</b> ${esc(out.mode)}</p>\n<p><b>Error:</b><br><code>${esc(out.error_message)}</code></p>\n${out.execution_url ? `<p><a href=\"${out.execution_url}\">Open the failed execution</a></p>` : '<p>(No execution URL - set N8N_EDITOR_BASE_URL / WEBHOOK_URL on your instance to get links.)</p>'}\n<p>Tip: if a prospect is stuck in a transient status (researching / pending_approval), reset its status in the Prospects tab.</p>`;\nreturn [{ json: out }];"
      },
      "id": "aa89b38c-19ab-d2db-3124-a912d263fd3c",
      "name": "Format Error Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Config').first().json.ALERT_EMAIL }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "90c9dbfe-3485-29ba-79bd-1bbeaa50d09c",
      "name": "Email Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        680,
        0
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const e = $('Format Error Details').first().json;\nreturn [{ json: { timestamp: e.timestamp, workflow: e.workflow, node: e.node, error_message: e.error_message,\n  execution_id: e.execution_id, execution_url: e.execution_url, mode: e.mode } }];"
      },
      "id": "e6b72116-ea4e-718c-c4c6-b88f20d1437e",
