      "id": "a90918b8-1543-0868-f05a-5612e725c82f",
      "name": "Read Prospects",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const lc = (s) => String(s ?? '').trim().toLowerCase();\nconst since = Date.now() - 7 * 864e5;\nconst events = $('Read Events').all().map(i => i.json).filter(r => r && r.timestamp && Date.parse(r.timestamp) >= since);\nconst prospects = $('Read Prospects').all().map(i => i.json).filter(r => r && r.prospect_id);\nconst count = (name) => events.filter(e => lc(e.event) === name).length;\nconst replyCats = {};\nfor (const e of events.filter(e => lc(e.event) === 'reply_received')) {\n  const cat = String(e.detail || '').split(':')[0].trim() || 'other'; replyCats[cat] = (replyCats[cat] || 0) + 1;\n}\nconst pipeline = {};\nfor (const p of prospects) pipeline[p.status || 'blank'] = (pipeline[p.status || 'blank'] || 0) + 1;\nconst sent = count('sent'), fu = count('followup_sent'), replies = count('reply_received');\nconst metrics = {\n  period: `${new Date(since).toISOString().slice(0, 10)} to ${new Date().toISOString().slice(0, 10)}`,\n  imported: count('imported'), import_rejected: count('import_rejected'), drafted: count('drafted'), disqualified: count('disqualified'),\n  research_failed: count('research_failed'), approved: count('approved') + count('approved_with_edits'), rejected: count('rejected'),\n  first_touch_sent: sent, followups_sent: fu, replies, reply_rate_pct: sent ? Math.round((replies / sent) * 1000) / 10 : 0,\n  reply_categories: replyCats, replies_we_sent: count('reply_sent'), bounced: count('bounced'), unsubscribed: count('unsubscribed'),\n  snoozed: count('snoozed'), errors: count('send_failed') + count('followup_failed') + count('reply_failed'), pipeline,\n};\nreturn [{ json: { metrics, metrics_text: JSON.stringify(metrics, null, 1).replace(/[{}]/g, ' ') } }];"
      },
      "id": "d8263aef-7352-d752-95c2-41938e02be4e",
      "name": "Compute Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Here are last week's cold outreach numbers for a freelance automation builder:\n{{ $json.metrics_text }}\n\nWrite exactly 3 short lines, plain text, no bullets or numbering: line 1 what happened, line 2 the most important signal (reply rate, bounces, approvals, or quality), line 3 one concrete action for next week. If volumes are tiny, say so plainly instead of over-interpreting.",
        "hasOutputParser": false
      },
