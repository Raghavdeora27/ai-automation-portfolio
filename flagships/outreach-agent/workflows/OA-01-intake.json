    {
      "parameters": {
        "jsCode": "const body = $('Webhook: Prospect API').first().json.body || {};\nlet list = Array.isArray(body) ? body : (Array.isArray(body.prospects) ? body.prospects : [body]);\nlist = list.filter(p => p && typeof p === 'object').slice(0, 200);\nreturn list.map(p => ({ json: {\n  first_name: p.first_name ?? p.firstName ?? '', last_name: p.last_name ?? p.lastName ?? '',\n  email: p.email ?? '', company: p.company ?? '', website: p.website ?? p.url ?? '',\n  timezone: p.timezone ?? '', notes: p.notes ?? '', source: p.source || 'webhook', _source: 'webhook' } }));"
      },
      "id": "650e40e9-1319-d00e-567a-7c1ac2ce4a11",
      "name": "Map Webhook Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        -140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Items come from \"OA-00 Form Intake\" (Execute Workflow, accept all data).\n// Accepts one prospect per item, or { prospects: [...] }. _source is forced to \"form\" so a caller\n// can never target sheet rows (_row_number is not passed through).\nconst out = [];\nfor (const item of $('When Executed by Another Workflow').all()) {\n  const j = item.json || {};\n  const list = Array.isArray(j.prospects) ? j.prospects : [j];\n  for (const p of list) {\n    if (!p || typeof p !== 'object') continue;\n    out.push({ json: {\n      first_name: p.first_name ?? p.firstName ?? '', last_name: p.last_name ?? p.lastName ?? '',\n      email: p.email ?? '', company: p.company ?? '', website: p.website ?? p.url ?? '',\n      timezone: p.timezone ?? '', notes: p.notes ?? '', source: p.source || 'form', _source: 'form' } });\n  }\n}\nreturn out.slice(0, 200);"
      },
      "id": "07c39c49-9340-56a7-590a-18710ff3c973",
      "name": "Map Form Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        100
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Prospects",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "status",
              "lookupValue": "new_import"
            }
          ]
        },
        "combineFilters": "AND",
        "options": {}
      },
      "id": "ac9eb10d-8ddc-6b9b-3388-36f716f8ee43",
      "name": "Read new_import Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        680,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "return $input.all().filter(i => i.json && i.json.row_number).map(i => ({ json: { ...i.json,\n  source: i.json.source || 'sheet_import', _source: 'sheet_import', _row_number: i.json.row_number } }));"
      },
      "id": "385ad2bf-00f1-4da0-aadc-bb770acf10c5",
      "name": "Map Sheet Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const CFG = $('Config').first().json;\nconst FREE = new Set(['gmail.com','googlemail.com','yahoo.com','yahoo.co.in','outlook.com','hotmail.com','live.com','icloud.com','me.com','aol.com','proton.me','protonmail.com','zoho.com','gmx.com','yandex.com','rediffmail.com','msn.com']);\nconst EMAIL_RE = /^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$/;\nconst clean = (s) => String(s ?? '').replace(/\\s+/g, ' ').trim();\n// cyrb53: small deterministic 53-bit hash (no crypto module needed). Two seeds -> 28 hex chars.\nfunction cyrb53(str, seed = 0) {\n  let h1 = 0xdeadbeef ^ seed, h2 = 0x41c6ce57 ^ seed;\n  for (let i = 0; i < str.length; i++) { const ch = str.charCodeAt(i); h1 = Math.imul(h1 ^ ch, 2654435761); h2 = Math.imul(h2 ^ ch, 1597334677); }\n  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507); h1 ^= Math.imul(h2 ^ (h2 >>> 13), 3266489909);\n  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507); h2 ^= Math.imul(h1 ^ (h1 >>> 13), 3266489909);\n  return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(16).padStart(14, '0');\n}\nfunction hostOf(url) {\n  let u = clean(url).toLowerCase();\n  if (!u) return '';\n  if (!/^https?:\\/\\//.test(u)) u = 'https://' + u;\n  try { return new URL(u).hostname.replace(/^www\\./, ''); } catch (e) { return ''; }\n}\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const email = clean(r.email).toLowerCase();\n  const emailDomain = email.includes('@') ? email.split('@').pop() : '';\n  let website = clean(r.website);\n  if (website && !/^https?:\\/\\//i.test(website)) website = 'https://' + website;\n  const webHost = hostOf(website);\n  // company domain: website host first, else business email domain\n  const domain = webHost || (FREE.has(emailDomain) ? '' : emailDomain);\n  if (!website && domain) website = 'https://' + domain;\n  let tz = clean(r.timezone);\n  if (!tz || !DateTime.now().setZone(tz).isValid) tz = CFG.DEFAULT_TIMEZONE;\n  const valid = EMAIL_RE.test(email);\n  out.push({ json: {\n    prospect_id: valid ? 'p_' + cyrb53(email, 1) + cyrb53(email, 7) : '',\n    first_name: clean(r.first_name).replace(/^./, c => c.toUpperCase()),\n    last_name: clean(r.last_name),\n    email, company: clean(r.company), domain, website, timezone: tz,\n    source: clean(r.source) || r._source || 'unknown',\n    notes: clean(r.notes),\n    _source: r._source, _row_number: r._row_number,\n    _email_domain: emailDomain, _free_email: FREE.has(emailDomain),\n    _valid_email: valid,\n  }});\n}\nreturn out;"
      },
      "id": "95294746-1865-0769-c971-bab3b03b3ec5",
